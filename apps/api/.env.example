# Copy to .env and fill in real values

# HTTP
PORT=4000
WEB_ORIGIN=http://localhost:3100

# Database — Neon serverless Postgres in prod; the local docker-compose
# spins up Postgres on host port 5433 (to avoid clashing with any system
# Postgres on 5432). The default below matches docker-compose.yml.
DATABASE_URL=postgresql://aux:dev@localhost:5433/aux

# Redis (Upstash)
REDIS_URL=redis://localhost:6379

# Object storage (Cloudflare R2 — S3-compatible)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=aux-stems-dev

# Auth
AUTH_SECRET=replace-me-with-a-256-bit-secret
MAGIC_LINK_TTL_SECONDS=600

# Email (Resend)
RESEND_API_KEY=

# Observability
SENTRY_DSN=

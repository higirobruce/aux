{
  "name": "aux",
  "version": "0.1.0",
  "private": true,
  "description": "A web-based mixing & mastering DAW for the engineer's chair.",
  "license": "SEE LICENSE IN docs/LICENSE-NOTES.md",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",

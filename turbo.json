{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["**/.env.*local"],
  "globalEnv": [
    "NODE_ENV",
    "PORT",
    "WEB_ORIGIN",
    "PUBLIC_BASE_URL",
    "API_INTERNAL_URL",
    "DATABASE_URL",
    "REDIS_URL",
    "R2_ENDPOINT",
    "R2_ACCESS_KEY_ID",
    "R2_SECRET_ACCESS_KEY",
    "R2_BUCKET",
    "AUTH_SECRET",
    "MAGIC_LINK_TTL_SECONDS",
    "RESEND_API_KEY",
    "SENTRY_DSN",
    "CTK_SENDER_EMAIL",
    "CTK_SENDER_PASSWORD",
    "CTK_APP_URL"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**", "build/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "clean": {
      "cache": false
    }
  }
}

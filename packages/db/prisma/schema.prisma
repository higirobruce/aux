// Prisma schema for aux.
// Mirrors docs/implementation.html §03 + §19 (presets) + §05 (share links).

generator client {
  provider = "prisma-client-js"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  name          String?
  emailVerified Boolean   @default(false) @map("email_verified")
  image         String?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt      @map("updated_at")
  lastSeenAt    DateTime? @map("last_seen_at")

  sessions       Session[]
  collaborators  Collaborator[]
  userPresets    UserPreset[]
  chainPresets   ChainPreset[]
  shareLinks     ShareLink[]
  authSessions   AuthSession[]
  accounts       Account[]

  @@map("users")
}

enum StorageMode {
  cloud
  local

  @@map("storage_mode")
}

model Session {
  id            String       @id @default(uuid())
  ownerId       String       @map("owner_id")
  name          String
  storageMode   StorageMode  @map("storage_mode")
  byoBucket     Json?        @map("byo_bucket")            // v2 — encrypted creds
  lastOpenedAt  DateTime?    @map("last_opened_at")
  archivedAt    DateTime?    @map("archived_at")
  createdAt     DateTime     @default(now()) @map("created_at")

  owner          User           @relation(fields: [ownerId], references: [id])
  stems          Stem[]
  snapshots      Snapshot[]
  collaborators  Collaborator[]
  renders        Render[]
  shareLinks     ShareLink[]

  @@index([ownerId])
  @@map("sessions")
}

model Stem {
  id              String   @id @default(uuid())
  sessionId       String   @map("session_id")
  name            String
  s3Key           String?  @map("s3_key")                  // null in local mode
  lengthMs        Int      @map("length_ms")
  channels        Int      @db.SmallInt
  sampleRate      Int      @map("sample_rate")
  peakDb          Float    @map("peak_db")
  lufsI           Float    @map("lufs_i")
  fingerprintV1   Bytes?   @map("fingerprint_v1")
  createdAt       DateTime @default(now()) @map("created_at")

  session  Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("stems")
}

model Snapshot {
  id          String     @id @default(uuid())
  sessionId   String     @map("session_id")
  parentId    String?    @map("parent_id")
  docState    Bytes      @map("doc_state")                 // serialized session doc
  message     String?
  createdAt   DateTime   @default(now()) @map("created_at")

  session     Session    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  parent      Snapshot?  @relation("SnapshotLineage", fields: [parentId], references: [id])
  children    Snapshot[] @relation("SnapshotLineage")
  shareLinks  ShareLink[]
  renders     Render[]

  @@index([sessionId])
  @@index([parentId])
  @@map("snapshots")
}

enum CollaboratorRole {
  owner
  editor
  listener

  @@map("collaborator_role")
}

model Collaborator {
  sessionId String           @map("session_id")
  userId    String           @map("user_id")
  role      CollaboratorRole
  addedAt   DateTime         @default(now()) @map("added_at")

  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId],    references: [id], onDelete: Cascade)

  @@id([sessionId, userId])
  @@map("collaborators")
}

enum RenderFormat {
  wav
  flac
  mp3
  aac

  @@map("render_format")
}

enum RenderStatus {
  queued
  running
  done
  failed

  @@map("render_status")
}

model Render {
  id          String        @id @default(uuid())
  sessionId   String        @map("session_id")
  snapshotId  String        @map("snapshot_id")
  format      RenderFormat
  targetLufs  Float?        @map("target_lufs")
  s3Key       String?       @map("s3_key")
  status      RenderStatus  @default(queued)
  createdAt   DateTime      @default(now()) @map("created_at")
  finishedAt  DateTime?     @map("finished_at")

  session   Session  @relation(fields: [sessionId],  references: [id], onDelete: Cascade)
  snapshot  Snapshot @relation(fields: [snapshotId], references: [id], onDelete: Restrict)

  @@index([sessionId])
  @@index([snapshotId])
  @@map("renders")
}

// Async sharing — per docs/implementation.html §05.
model ShareLink {
  id          String    @id @default(uuid())
  sessionId   String    @map("session_id")
  snapshotId  String    @map("snapshot_id")
  createdById String    @map("created_by")
  expiresAt   DateTime? @map("expires_at")
  revokedAt   DateTime? @map("revoked_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  session    Session  @relation(fields: [sessionId],   references: [id], onDelete: Cascade)
  snapshot   Snapshot @relation(fields: [snapshotId],  references: [id], onDelete: Cascade)
  createdBy  User     @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([sessionId])
  @@index([snapshotId])
  @@index([createdById])
  @@map("share_links")
}

// Plugin presets — per docs/implementation.html §19.
model UserPreset {
  id              String   @id @default(uuid())
  ownerId         String   @map("owner_id")
  plugin          String                                    // 'EQ-8', 'Comp-A', etc.
  schemaVersion   Int      @map("schema_version")
  label           String
  state           Json
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  owner   User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@index([plugin])
  @@map("user_presets")
}

model ChainPreset {
  id          String   @id @default(uuid())
  ownerId     String   @map("owner_id")
  label       String
  chain       Json                                          // [{ plugin, schemaVersion, state }, ...]
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  owner   User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@map("chain_presets")
}

// ============================================================================
// AUTH — better-auth tables. Mapped to auth_* to keep the Session/Account
// namespace free for the mix-session domain. Schema shape per better-auth
// (https://better-auth.com/docs/concepts/database#core-schema).
// ============================================================================

model AuthSession {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt       @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("auth_sessions")
}

model Account {
  id                    String    @id @default(uuid())
  userId                String    @map("user_id")
  accountId             String    @map("account_id")     // provider-specific external id
  providerId            String    @map("provider_id")    // 'magic-link', 'google', ...
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt       @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("auth_accounts")
}

model Verification {
  id         String   @id @default(uuid())
  identifier String                                       // usually email
  value      String                                       // the token (hashed by better-auth)
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt       @map("updated_at")

  @@index([identifier])
  @@map("auth_verifications")
}
